{
  "mcpServers": {
    "angular-cli": {
      "type": "local",
      "command": "pnpm",
      "args": ["exec", "ng", "mcp"],
      "tools": ["*"]
    },
    "Astro docs": {
      "type": "http",
      "url": "https://mcp.docs.astro.build/mcp",
      "tools": ["*"]
    },
    "primeng": {
      "type": "local",
      "command": "pnpm",
      "args": ["dlx", "@primeng/mcp"],
      "tools": ["*"]
    }
  }
}
