{
  "name": "@ngx-formly/builder-package-consumer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "ng build consumer",
    "start": "ng serve consumer --host 127.0.0.1 --port 4314"
  },
  "dependencies": {
    "@angular/cdk": "^22.2.4",
    "@angular/common": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@primeuix/themes": "^2.0.3",
    "primeng": "^21.1.10"
  },
  "devDependencies": {
    "@angular/build": "^22.2.3",
    "@angular/cli": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/compiler-cli": "^22.2.3",
    "@tailwindcss/postcss": "^4.1.17",
    "postcss": "^8.5.6",
    "typescript": "~6.0.3"
  },
  "pnpm": {
    "overrides": {
      "primeng>@angular/cdk": "$@angular/cdk",
