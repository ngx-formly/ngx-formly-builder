  "version": "0.2.0",
  "configurations": [
    {
      "name": "Studio (pnpm start)",
      "type": "chrome",
      "request": "launch",
      "preLaunchTask": "start",
      "url": "http://localhost:4200/"
    },
    {
      "name": "Vitest (pnpm test)",
      "type": "node-terminal",
      "request": "launch",
      "command": "pnpm test",
      "cwd": "${workspaceFolder}"
    }
  ]
}
