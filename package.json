{
  "name": "ngx-formly-builder",
  "version": "0.0.0",
  "author": "Samuel Esan (https://github.com/sesan07)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ngx-formly/ngx-formly-builder.git"
  },
  "homepage": "https://formlystudio.com/",
  "scripts": {
    "prepare": "husky",
    "ng": "ng",
    "dev": "pnpm --recursive --parallel run dev",
    "dev:portless": "pnpm --recursive --parallel run dev:portless",
    "start": "pnpm --filter @ngx-formly/builder-studio run dev",
    "start:docs": "pnpm --filter @ngx-formly/builder-docs run dev",
    "build": "pnpm run build:builder-material && pnpm run check:packages && pnpm run build:studio && pnpm run build:docs",
    "build:studio": "ng build studio",
    "build:state": "ng build state",
    "build:core": "pnpm run build:state && ng build core",
    "build:material": "ng build material",
    "build:builder-material": "pnpm run build:core && pnpm run build:material && ng build builder-material",
    "build:docs": "pnpm --filter @ngx-formly/builder-docs run build",
    "check:docs": "pnpm --filter @ngx-formly/builder-docs run check",
    "check:packages": "node scripts/check-package-contracts.mjs && node scripts/check-packed-consumer.mjs",
    "check:api": "pnpm run build:builder-material && node scripts/check-api.mjs",
    "update:api": "pnpm run build:builder-material && node scripts/check-api.mjs --update",
    "test:api": "node --test scripts/check-api.test.mjs",
    "check:packages:e2e": "node scripts/check-packed-consumer.mjs --browser",
    "preview:docs": "pnpm --filter @ngx-formly/builder-docs run preview",
    "test:e2e": "playwright test --config apps/studio/playwright.config.ts",
    "test": "pnpm run test:studio && pnpm run test:state && pnpm run test:core && pnpm run test:material && pnpm run test:builder-material",
    "test:studio": "ng test studio --watch=false",
    "test:state": "ng test state --watch=false",
    "test:core": "ng test core --watch=false",
    "test:material": "ng test material --watch=false",
    "test:builder-material": "ng test builder-material --watch=false",
    "lint": "ng lint studio && ng lint state && ng lint core && ng lint material && ng lint builder-material",
    "changeset": "changeset",
    "release:status": "changeset status",
    "release:version": "changeset version && pnpm install --lockfile-only --ignore-scripts",
    "release:dry-run": "node scripts/release-dry-run.mjs",
    "release:validate": "pnpm run build:builder-material && pnpm run check:packages && node scripts/check-release-artifacts.mjs && pnpm run release:dry-run --consumer",
    "release:publish": "pnpm run release:validate && changeset publish",
    "test:release": "node --test scripts/check-release-artifacts.test.mjs && pnpm run release:dry-run"
  },
  "private": true,
  "packageManager": "pnpm@10.25.0",
  "dependencies": {
    "@angular/animations": "^22.2.3",
    "@angular/cdk": "^22.2.4",
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/material": "^22.2.4",
    "@angular/platform-browser": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@dragdroptouch/drag-drop-touch": "^2.0.3",
    "@ngx-formly/bootstrap": "^11.0.0",
    "@ngx-formly/core": "^11.0.0",
    "@ngx-formly/material": "^11.0.0",
    "@ngx-formly/ng-zorro-antd": "^11.0.0",
    "@primeuix/themes": "^2.0.3",
    "@uiw/codemirror-theme-vscode": "^4.25.11",
    "bootstrap": "^5.3.8",
    "codemirror": "^6.0.2",
    "date-fns": "^4.1.0",
    "dompurify": "^3.4.15",
    "file-saver": "^2.0.5",
    "js-beautify": "^1.15.4",
    "lodash-es": "^4.17.21",
    "marked": "^18.0.13",
    "mutative": "^1.3.0",
    "ng-zorro-antd": "^22.1.2",
    "ngx-drag-drop": "^22.1.0",
    "primeng": "^21.1.10",
    "rxjs": "~7.8.0",
    "tailwindcss": "^4.1.17",
    "tailwindcss-primeui": "^0.6.1",
    "terser": "^5.51.2",
    "tslib": "^2.3.0",
    "uuid": "^13.0.0",
    "zod": "^4.6.7",
    "zone.js": "0.16.3"
  },
  "devDependencies": {
    "@angular/build": "^22.2.3",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "^22.2.3",
    "@changesets/cli": "3.0.3",
    "@eslint/js": "^9.8.0",
    "@playwright/test": "^1.36.0",
    "@tailwindcss/postcss": "^4.1.17",
    "@types/file-saver": "^2.0.7",
    "@types/js-beautify": "^1.14.3",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "4.1.9",
    "angular-eslint": "22.6.0",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-playwright": "^1.6.2",
    "husky": "^9.1.7",
    "jsdom": "~28.0.0",
    "less": "^4.9.1",
    "ng-packagr": "^22.2.4",
    "portless": "^0.16.0",
    "postcss": "^8.5.6",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.40.0",
    "vitest": "4.1.9"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  }
}
